# NabuStation voice server configuration.
# Copy to voice.env and fill in your values.  Keep it private (chmod 600).

# --- Station 1 -----------------------------------------------------------
STATION_HOST=192.168.1.10
MIC_PORT=8091
PLAY_PORT=8092
LED_PORT=8093
BUTTON_PORT=8095
COMMAND_PORT=8096
DEBIAN_VOLUME_URL=http://192.168.1.10:8098
# Last voice-set level used when station_volume.txt does not exist yet.
STATION_VOLUME_DEFAULT=5

# --- Home Assistant ------------------------------------------------------
HA_HOST=127.0.0.1
HA_TOKEN_FILE=/home/youruser/nabustation/voice/ha_token.txt
# Optional: exact pipeline name.  Empty = HA's preferred pipeline.
PIPELINE_NAME=
# Music Assistant player entity.  Leave it set even if you do not use music;
# the agent simply skips pause/resume when the entity is unavailable.
MUSIC_ENTITY=media_player.station_1

# --- TTS -----------------------------------------------------------------
SILERO_URL=http://127.0.0.1:10400/tts
SILERO_VOICE=eugene
TTS_RATE=48000
TTS_GAIN=0.9

# --- Wake word / AEC -----------------------------------------------------
MIC_ORDER=debian
MIC_GAIN=14
MUSIC_REF_RMS=10
WAKE_DUCK_RMS=100000
WAKE_THRESHOLD=0.15
WAKE_THRESHOLD_MUSIC=0.15
WAKE_HITS_MIN=1
WAKE_HIGH=0.75
WAKE_HIGH_MUSIC=0.7

# Optional utterance tuning (defaults are shown).
# SILENCE_MS=600
# MAX_UTTERANCE_MS=6000
# VAD_RMS=200
# VAD_NOISE_FACTOR=1.35
# VAD_SPEECH_FACTOR=0.25
