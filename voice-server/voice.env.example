# NabuStation voice server configuration.
# Copy to voice.env and fill in your values.  Keep it private (chmod 600).

# --- Station 1 -----------------------------------------------------------
STATION_HOST=192.168.1.10
MIC_PORT=8091
PLAY_PORT=8092
LED_PORT=8093
BUTTON_PORT=8095
COMMAND_PORT=8096
# HTTP control API for the phone remote (PTT/SAY) and HA announcements.
CONTROL_PORT=8090
CONTROL_BIND=0.0.0.0
DEBIAN_VOLUME_URL=http://192.168.1.10:8098
# Last voice-set level used when station_volume.txt does not exist yet.
STATION_VOLUME_DEFAULT=5

# --- Home Assistant ------------------------------------------------------
HA_HOST=127.0.0.1
HA_TOKEN_FILE=/home/youruser/nabustation/voice/ha_token.txt
# Optional: exact pipeline name.  Empty = HA's preferred pipeline.
PIPELINE_NAME=
# Music Assistant player entity.  Leave it set even if you do not use music;
# the agent simply skips pause/resume when the entity is unavailable.
MUSIC_ENTITY=media_player.station_1

# Music ducking while the assistant listens/speaks.  Only the Music Assistant
# player volume changes; the station amplifier stays at its 5% limit.
MUSIC_DUCK_LOUD=0.15
MUSIC_DUCK_QUIET=0.05
MUSIC_DUCK_THRESHOLD=15

# --- TTS -----------------------------------------------------------------
SILERO_URL=http://127.0.0.1:10400/tts
SILERO_VOICE=eugene
TTS_RATE=48000
TTS_GAIN=0.9
# Optional: sounds live next to station_voice.py by default.
# TIMER_SOUND=/path/to/sounds/timer.wav
# ALARM_SOUND=/path/to/sounds/alarm.mp3

# --- Timers / alarms / night mode ---------------------------------------
# State files default to the voice-server directory.
# TIMER_FILE=/path/timers.json
# ALARM_FILE=/path/alarms.json
# ALARM_MEDIA_FILE=/path/alarm_media.json
# NIGHT_FILE=/path/night.json
ALARM_START_LEVEL=5
ALARM_MAX_LEVEL=70
ALARM_RAMP_SECONDS=180
ALARM_DUCK_LEVEL=5
ALARM_DUCK_SECONDS=6
# Wake word score needed to interrupt a ringing alarm.
ALARM_WAKE_THRESHOLD=0.35
ALARM_WAKE_HITS=1
ALARM_MAX_UTTERANCE_MS=4000
NIGHT_VOLUME=5
NIGHT_DEFAULT_EXIT=10:00
# Optional override; empty means read Home Assistant /api/config time_zone.
# ALARM_TZ=Asia/Krasnoyarsk

# --- Wake word / AEC -----------------------------------------------------
MIC_ORDER=debian
MIC_GAIN=14
MUSIC_REF_RMS=10
WAKE_DUCK_RMS=100000
WAKE_THRESHOLD=0.15
WAKE_THRESHOLD_MUSIC=0.15
WAKE_HITS_MIN=1
WAKE_HIGH=0.75
WAKE_HIGH_MUSIC=0.7

# Optional utterance tuning (defaults are shown).
# SILENCE_MS=600
# MAX_UTTERANCE_MS=6000
# VAD_RMS=200
# VAD_NOISE_FACTOR=1.35
# VAD_SPEECH_FACTOR=0.25
