# Copy to .env and fill in. This file is read by the installers; it is not
# used by the running services. Keep it private (chmod 600).

# Station 1
STATION_HOST=192.168.1.10
# Optional: Android Snapcast hostID to reuse the same MA player.
STATION_HOST_ID=
SNAPCAST_HOST=192.168.1.20
SNAPCAST_PORT=1704

# Home Assistant
HA_HOST=127.0.0.1
HA_TOKEN=
HA_MEDIA_PLAYER=media_player.station_1
LIKED_PLAYLIST=
MA_PLAYER_NAME=Station 1

# Optional port overrides
MIC_PORT=8091
PLAY_PORT=8092
LED_PORT=8093
BUTTON_PORT=8095
VOLUME_PORT=8098
SILERO_PORT=10400
