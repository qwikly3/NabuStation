# NabuStation visualizer configuration.
# Copy to visualizer.env.  The service reads this file.
HA_HTTP=http://127.0.0.1:8123
HA_TOKEN_FILE=/home/youruser/nabustation/voice/ha_token.txt
PLAYER_ENTITY=media_player.station_1
# Optional: dynamic Spotify Liked Songs URI for the "liked" action.
MUSIC_LIKED_URI=
PORT=8099
