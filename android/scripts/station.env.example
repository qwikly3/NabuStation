# NabuStation Android station configuration.
# Copy to /data/voice/station.env on the station (chmod 600).
SNAPCAST_HOST=192.168.1.20
SNAPCAST_PORT=1705
HA_HOST=192.168.1.20
VISUALIZER_HOST=192.168.1.20
VISUALIZER_PORT=8099
# Launcher started after boot.  TV Launcher (GPL) is the default/open one.
# Projectivy is optional (install from its official releases) and uses:
# LAUNCHER=com.spocky.projengmenu/com.spocky.projengmenu.ui.home.MainActivity
LAUNCHER=com.tvlauncher/.MainActivity
