#!/system/bin/sh
# Live-ish station screen for the browser: one PNG per request.
export ANDROID_ROOT=/system
export ANDROID_DATA=/data
export ANDROID_STORAGE=/storage
export PATH=/system/bin:/system/xbin
printf 'Content-Type: image/png\r\nCache-Control: no-cache, no-store, must-revalidate\r\nPragma: no-cache\r\nExpires: 0\r\n\r\n'
exec screencap -p
